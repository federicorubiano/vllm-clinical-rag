# ── Model servers (run TWO at once via `anaconda ai launch`) ─────────────────
# A live query needs the embedding model AND the chat model serving at the same
# time. Anaconda Desktop's UI runs one server at a time, so use the CLI helper:
#   bash scripts/serve_models.sh
# It launches both and fills in the two *_API_URL lines below (ports are assigned
# dynamically per launch, so re-run it after restarting the servers).
# DESKTOP_API_URL is only a fallback if the role-specific URLs are unset.
DESKTOP_API_URL=http://localhost:8080/v1
EMBEDDING_API_URL=http://localhost:8080/v1     # set automatically by serve_models.sh
INFERENCE_API_URL=http://localhost:8080/v1     # set automatically by serve_models.sh

# ── Models ────────────────────────────────────────────────────────────────────
# Inference (chat) model. Recommended: Qwen2.5-14B-Instruct — non-thinking, so no
# reasoning-token burn. Alternatives: phi-4 (14B), Qwen3-8B.
INFERENCE_MODEL=Qwen2.5-14B-Instruct

# Embedding model. Recommended: Qwen3-Embedding-8B (4096-dim, top MTEB).
# ⚠️ Changing this changes the vector dimension — you MUST rebuild the index:
#   python scripts/build_index.py
EMBEDDING_MODEL=Qwen3-Embedding-8B

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks returned to the LLM (post FAISS search).
# Ranking uses Qwen3-Embedding's instruction-following design, which handles
# query/document asymmetry natively.
TOP_K=5

# ── Paths ─────────────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
FAISS_INDEX_PATH=data/index/merck.faiss
CHUNK_METADATA_PATH=data/index/chunks.json

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
