# ── Anaconda Desktop Model Server ────────────────────────────────────────────
# URL of your running Anaconda Desktop local model server.
# In Desktop: select a model → Start Server. Default port is 8080.
DESKTOP_API_URL=http://localhost:8080/v1

# ── Models ────────────────────────────────────────────────────────────────────
# Inference model — must be loaded as a server in Anaconda Desktop.
# Recommended: Qwen3-8B (chat, tool-calling, 2025 model)
INFERENCE_MODEL=Qwen3-8B

# Embedding model — must be loaded as a server in Anaconda Desktop.
# Recommended: Qwen3-Embedding-4B (instruction-following, MTEB top-tier, 2025)
EMBEDDING_MODEL=Qwen3-Embedding-4B

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks returned to the LLM (post FAISS search).
# Cross-encoder reranking removed — Qwen3-Embedding instruction-following
# handles query/document asymmetry natively.
TOP_K=5

# ── Paths ─────────────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
FAISS_INDEX_PATH=data/index/merck.faiss
CHUNK_METADATA_PATH=data/index/chunks.json

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
