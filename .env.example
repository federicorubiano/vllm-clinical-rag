# ── vLLM Server ───────────────────────────────────────────────────────────────
# URL of your running vLLM OpenAI-compatible server
VLLM_BASE_URL=http://localhost:8001/v1

# HuggingFace model ID loaded by vLLM
# Requires GPU with sufficient VRAM:
#   Mistral-7B  → ~16GB VRAM (fp16)
#   Qwen2.5-7B  → ~16GB VRAM (fp16)
#   Qwen2.5-3B  → ~8GB  VRAM (fp16)
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Retrieval ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=thenlper/gte-large
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVE=10
TOP_K_RERANK=4

# ── Paths ─────────────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
FAISS_INDEX_PATH=data/index/merck.faiss
CHUNK_METADATA_PATH=data/index/chunks.json

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── HuggingFace (for model download) ─────────────────────────────────────────
# Optional — only needed if downloading gated models
# HF_TOKEN=your_token_here
